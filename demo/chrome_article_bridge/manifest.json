{
  "manifest_version": 3,
  "name": "Chatbot Page Bridge",
  "version": "0.2.0",
  "description": "Passes the visible webpage's main text to the local chatbot reader.",
  "host_permissions": ["http://127.0.0.1:7860/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this page to Chatbot"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
